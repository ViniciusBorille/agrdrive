POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=1080

# ATENÇÃO: este arquivo é versionado no Git. Ele só pode conter valores
# de desenvolvimento local que não sejam secretos. Qualquer credencial
# real (client secret, chave de API, senha de serviço externo) vai em
# `.env.development.local`, que é ignorado pelo Git.

# Módulo Agenda de campo - integração com Google Calendar.
# Passo a passo para preencher as credenciais:
#   1. Crie (ou reutilize) um projeto em https://console.cloud.google.com/
#   2. Ative a "Google Calendar API" em APIs e serviços > Biblioteca.
#   3. Configure a tela de consentimento OAuth (modo "Externo" + usuários de teste, se o app não for verificado).
#   4. Em APIs e serviços > Credenciais, crie um "ID do cliente OAuth" do tipo "Aplicativo da Web".
#   5. Adicione GOOGLE_OAUTH_REDIRECT_URI como URI de redirecionamento autorizado.
#   6. Copie o Client ID e o Client Secret para o seu `.env.development.local`:
#        GOOGLE_CLIENT_ID=...
#        GOOGLE_CLIENT_SECRET=...
# Sem essas credenciais preenchidas, a Agenda de campo funciona normalmente
# como calendário local — apenas o botão "Conectar ao Google Calendar" falha.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/google-calendar/callback

# Chave AES-256 (32 bytes em base64) usada para cifrar em repouso os
# tokens OAuth guardados no banco. O valor abaixo é fixo e público, só
# serve para desenvolvimento e CI — protege apenas dados locais.
# Em produção, gere uma chave própria e injete pelo gerenciador de
# segredos, nunca por arquivo versionado:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=6Q7NL6ssDLRihnvuGc6uZBdqCD+083WtRnFeFIjhwZU=
